    "react-dom": "^16.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^9.2.1",
    "babel-plugin-import": "^1.13.8",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "svg-sprite-loader": "^6.0.11",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
